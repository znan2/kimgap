# 이 파일은 Git에 올려도 됩니다(실제 비밀값 없음).
# 로컬에서는 복사해서 .env 를 만드세요:  cp .env.example .env
# Vercel: Project → Settings → Environment Variables 에 동일한 이름으로 등록

# 선택: 업비트·빗썸 입출금/한도 API (없으면 해당 기능만 비활성)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=

# 선택: WebSocket 푸시 주기(초), 기본 5
GAP_WS_INTERVAL_SEC=5

# 선택: 텔레그램 알림/명령 설정
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=true
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_POLL_INTERVAL_SEC=2
ALERT_GAP_THRESHOLD=4.0
ALERT_BANNED_TICKERS=
ALERT_COOLDOWN_SEC=300
ALERT_CONFIG_PATH=
